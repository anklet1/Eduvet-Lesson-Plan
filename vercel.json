{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/eduvet",
      "destination": "/eduvet.html"
    },
    {
      "source": "/eduvet.html",
      "destination": "/eduvet.html"
    },
    {
      "source": "/login",
      "destination": "/eduvet.html"
    },
    {
      "source": "/app",
      "destination": "/eduvet.html"
    },
    {
      "source": "/eduvet.css",
      "destination": "/eduvet.css"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/eduvet.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}