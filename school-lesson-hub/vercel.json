{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/eduvet",
      "destination": "/eduvet.html"
    },
    {
      "source": "/eduvet.html",
      "destination": "/eduvet.html"
    },
    {
      "source": "/login",
      "destination": "/eduvet.html"
    },
    {
      "source": "/app",
      "destination": "/eduvet.html"
    },
    {
      "source": "/eduvet.css",
      "destination": "/eduvet.css"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(css|js|woff2|woff|ttf|png|svg|ico|webp))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}