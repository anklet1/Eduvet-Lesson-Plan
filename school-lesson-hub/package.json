{
  "name": "school-lesson-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i src/index.css -o public/eduvet.css --minify",
    "build": "npm run build:css && tsc && vite build && node -e \"const fs=require('fs'); fs.copyFileSync('public/eduvet.html','dist/eduvet.html'); fs.copyFileSync('index.html','dist/index.html'); fs.copyFileSync('index.html','public/index.html'); fs.copyFileSync('public/eduvet.css','dist/eduvet.css');\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.460.0",
    "canvas-confetti": "^1.9.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
